{
    "name": "@odg/events",
    "version": "0.0.1",
    "description": "Events Interface for Ioc",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGMono/tree/main/packages/events",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODGodinho/ODGMono.git",
        "directory": "packages/events"
    },
    "scripts": {
        "build": "rimraf dist/ && yarn tsc:build && yarn tsc:alias",
        "build:watch": "concurrently 'yarn tsc:build -w' 'yarn tsc:alias -w'",
        "dev": "tsx ./src/index.ts",
        "start": "node ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias -p tsconfig.build.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md",
        "./agents.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "workspace:^",
        "@odg/tsconfig": "workspace:^",
        "@types/node": ">=24",
        "@vitest/coverage-istanbul": "^4.1.9",
        "concurrently": "^10.0.3",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.8.17",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@odg/exception": "workspace:^",
        "eventemitter2": "^6.4.9"
    }
}
