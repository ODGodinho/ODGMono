{
    "name": "@odg/tls",
    "version": "0.0.0",
    "description": "Stanley TheTemplate for typescript project",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGMono/tree/main/packages/tls",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODGodinho/ODGMono.git",
        "directory": "packages/tls"
    },
    "scripts": {
        "build": "rimraf dist/ && bun run tsc:build && bun run tsc:alias",
        "build:watch": "concurrently 'bun run tsc:build -w' 'bun run tsc:alias -w'",
        "dev": "tsx ./src/index.ts",
        "start": "node ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias -p tsconfig.build.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md",
        "./AGENTS.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "workspace:^",
        "@odg/tsconfig": "workspace:^",
        "@types/node": ">=24",
        "@vitest/coverage-istanbul": "^4.1.10",
        "concurrently": "^10.0.3",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@odg/axios": "workspace:^",
        "@odg/exception": "workspace:^",
        "@odg/message": "workspace:^",
        "axios": "^1.18.1"
    },
    "peerDependencies": {
        "@odg/axios": "workspace:^",
        "@odg/exception": "workspace:^",
        "@odg/message": "workspace:^",
        "axios": "*"
    },
    "packageManager": "yarn@4.17.1"
}
