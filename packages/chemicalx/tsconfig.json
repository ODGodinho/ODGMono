{
    "extends": "@odg/tsconfig/tsconfig.node.json",
    "compilerOptions": {
        "outDir": "./dist",
        "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
        "paths": {
            "#types": [ "./src/types/index.ts" ],
            "#app": [ "./src/index.ts" ],
            "#app/*": [ "./src/*.ts", "./src/*/index.ts" ],
            "#browser": [ "./src/Browser/index.ts" ],
            "#browser/*": [ "./src/Browser/*.ts", "./src/Browser/*/index.ts" ],
            "#configs": [ "./src/Configs/index.ts" ],
            "#configs/*": [ "./src/Configs/*.ts", "./src/Configs/*/index.ts" ],
            "#engine": [ "./src/engine/index.ts" ],
            "#enums": [ "./src/Enums/index.ts" ],
            "#enums/*": [ "./src/Enums/*.ts", "./src/Enums/*/index.ts" ],
            "#exceptions": [ "./src/Exceptions/index.ts" ],
            "#exceptions/*": [ "./src/Exceptions/*.ts", "./src/Exceptions/*/index.ts" ],
            "#factory": [ "./src/Factory/index.ts" ],
            "#factory/*": [ "./src/Factory/*.ts", "./src/Factory/*/index.ts" ],
            "#handlers": [ "./src/Handlers/index.ts" ],
            "#handlers/*": [ "./src/Handlers/*.ts", "./src/Handlers/*/index.ts" ],
            "#interfaces": [ "./src/Interfaces/index.ts" ],
            "#interfaces/*": [ "./src/Interfaces/*.ts", "./src/Interfaces/*/index.ts" ],
            "#listeners": [ "./src/Listeners/index.ts" ],
            "#listeners/*": [ "./src/Listeners/*.ts", "./src/Listeners/*/index.ts" ],
            "#validator": [ "./src/Validator/index.ts" ],
            "#validator/*": [ "./src/Validator/*.ts", "./src/Validator/*/index.ts" ],
            "#pages": [ "./src/Pages/index.ts" ],
            "#pages/*": [ "./src/Pages/*.ts", "./src/Pages/*/index.ts" ],
            "#providers": [ "./src/Provider/index.ts" ],
            "#providers/*": [ "./src/Provider/*.ts", "./src/Provider/*/index.ts" ],
            "#selectors": [ "./src/Selectors/index.ts" ],
            "#selectors/*": [ "./src/Selectors/*.ts", "./src/Selectors/*/index.ts" ],
            "#services": [ "./src/Services/index.ts" ],
            "#services/*": [ "./src/Services/*.ts", "./src/Services/*/index.ts" ],
            "#helpers": [ "./src/Helpers/index.ts" ],
            "#helpers/*": [ "./src/Helpers/*.ts", "./src/Helpers/*/index.ts" ],
            "#support/*": [ "./src/Support/*.ts", "./src/Support/*/index.ts" ]
        },
        "rootDir": ".",
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "exclude": [
        "node_modules/",
        "dist/"
    ],
    "include": [ "." ]
}
