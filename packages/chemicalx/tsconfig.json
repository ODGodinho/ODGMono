{
    "extends": "@odg/tsconfig/tsconfig.node.json",
    "compilerOptions": {
        "outDir": "./dist",
        "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
        "paths": {
            "#types": [ "./src/types" ],
            "#app": [ "./src" ],
            "#app/*": [ "./src/*" ],
            "#browser": [ "./src/Browser" ],
            "#browser/*": [ "./src/Browser/*" ],
            "#configs": [ "./src/Configs" ],
            "#configs/*": [ "./src/Configs/*" ],
            "#engine": [ "./src/engine" ],
            "#enums": [ "./src/Enums" ],
            "#enums/*": [ "./src/Enums/*" ],
            "#exceptions": [ "./src/Exceptions" ],
            "#exceptions/*": [ "./src/Exceptions/*" ],
            "#factory": [ "./src/Factory" ],
            "#factory/*": [ "./src/Factory/*" ],
            "#handlers": [ "./src/Handlers" ],
            "#handlers/*": [ "./src/Handlers/*" ],
            "#interfaces": [ "./src/Interfaces" ],
            "#interfaces/*": [ "./src/Interfaces/*" ],
            "#listeners": [ "./src/Listeners" ],
            "#listeners/*": [ "./src/Listeners/*" ],
            "#validator": [ "./src/Validator" ],
            "#validator/*": [ "./src/Validator/*" ],
            "#pages": [ "./src/Pages" ],
            "#pages/*": [ "./src/Pages/*" ],
            "#providers": [ "./src/Provider" ],
            "#providers/*": [ "./src/Provider/*" ],
            "#selectors": [ "./src/Selectors" ],
            "#selectors/*": [ "./src/Selectors/*" ],
            "#services": [ "./src/Services" ],
            "#services/*": [ "./src/Services/*" ],
            "#helpers": [ "./src/Helpers" ],
            "#helpers/*": [ "./src/Helpers/*" ],
            "#support/*": [ "./src/Support/*" ]
        },
        "rootDir": ".",
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "exclude": [
        "node_modules/",
        "dist/"
    ],
    "include": [ "." ]
}
