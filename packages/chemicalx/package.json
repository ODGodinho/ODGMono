{
    "name": "@odg/chemical-x",
    "version": "0.0.0",
    "description": "Chemical-X Project It's the basis of everything",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGMono/tree/main/packages/chemicalx",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODGodinho/ODGMono.git",
        "directory": "packages/chemicalx"
    },
    "exports": {
        ".": "./dist/index.js",
        "./container": "./dist/Container.js"
    },
    "scripts": {
        "tsc": "tsc --noEmit -p tsconfig.build.json",
        "build": "rimraf dist/ && tsc --project ./tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:watch": "npm run build && (concurrently \"tsc --project ./tsconfig.build.json -w\" \"tsc-alias -p tsconfig.build.json -w\")",
        "start": "node ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md",
        "agents.md",
        "docs/**"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "workspace:^",
        "@odg/events": "workspace:^",
        "@odg/tsconfig": "workspace:^",
        "@types/node": ">=24",
        "@vitest/coverage-istanbul": "^4.1.7",
        "concurrently": "^9.2.1",
        "playwright": "^1.60.0",
        "puppeteer": "^25.1.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.8.17",
        "typescript": "^5.9.3",
        "vite": "^8.0.14",
        "vitest": "^4.1.7"
    },
    "dependencies": {
        "@inversifyjs/strongly-typed": "^3.0.0",
        "@odg/exception": "workspace:^",
        "inversify": "^8.1.0"
    },
    "peerDependencies": {
        "@inversifyjs/strongly-typed": "^2.2.0",
        "@odg/events": "workspace:^",
        "inversify": "^7.1.0",
        "reflect-metadata": ">=0.2.2"
    },
    "peerDependenciesMeta": {
        "@inversifyjs/strongly-typed": {
            "optional": true
        },
        "@odg/events": {
            "optional": true
        },
        "inversify": {
            "optional": true
        },
        "reflect-metadata": {
            "optional": true
        }
    }
}
