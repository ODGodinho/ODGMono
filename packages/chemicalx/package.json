{
    "name": "@odg/chemical-x",
    "version": "0.0.0",
    "description": "Chemical-X Project It's the basis of everything",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGMono/tree/main/packages/chemicalx",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODGodinho/ODGMono.git",
        "directory": "packages/chemicalx"
    },
    "exports": {
        ".": "./dist/index.js",
        "./container": "./dist/Container.js"
    },
    "scripts": {
        "build": "rimraf dist/ && bun run tsc:build && bun run tsc:alias",
        "build:watch": "concurrently 'bun run tsc:build -w' 'bun run tsc:alias -w'",
        "dev": "tsx ./src/index.ts",
        "start": "node ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias -p tsconfig.build.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md",
        "./AGENTS.md",
        "docs/**"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "workspace:^",
        "@odg/events": "workspace:^",
        "@odg/tsconfig": "workspace:^",
        "@types/node": ">=24",
        "@vitest/coverage-istanbul": "^4.1.10",
        "concurrently": "^10.0.3",
        "playwright": "^1.61.1",
        "puppeteer": "^25.3.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.1",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@inversifyjs/strongly-typed": "^3.0.0",
        "@odg/exception": "workspace:^",
        "inversify": "^8.2.1"
    },
    "peerDependencies": {
        "@inversifyjs/strongly-typed": ">=2.2.0",
        "@odg/events": "workspace:^",
        "inversify": ">=7.1.0",
        "reflect-metadata": ">=0.2.2"
    },
    "peerDependenciesMeta": {
        "@inversifyjs/strongly-typed": {
            "optional": true
        },
        "@odg/events": {
            "optional": true
        },
        "inversify": {
            "optional": true
        },
        "reflect-metadata": {
            "optional": true
        }
    }
}
