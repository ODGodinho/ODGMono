{
    "name": "@odg/eslint-plugin",
    "version": "0.0.0",
    "description": "ODG Linter custom rules plugins",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "homepage": "",
    "scripts": {
        "build": "rimraf dist/ && bun run tsc:build && bun run tsc:alias",
        "build:watch": "concurrently 'bun run tsc:build -w' 'bun run tsc:alias -w'",
        "dev": "tsx ./src/index.ts",
        "start": "node ./dist/index.js",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias -p tsconfig.build.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/tsconfig": "workspace:^",
        "@types/eslint": "^9.6.1",
        "@types/node": "^26.6.2",
        "@typescript-eslint/parser": "^8.70.1",
        "@vitest/coverage-istanbul": "^5.0.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "rimraf": "^6.1.3",
        "semantic-release": "^25.0.9",
        "tsc-alias": "^1.9.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@es-joy/jsdoccomment": "^0.98.0",
        "@typescript-eslint/types": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "comment-parser": "^1.4.9"
    }
}
