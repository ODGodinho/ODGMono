{
    "name": "@odg/eslint-plugin",
    "version": "0.0.0",
    "description": "ODG Linter custom rules plugins",
    "main": "index.js",
    "types": "dist/index.d.ts",
    "homepage": "",
    "scripts": {
        "build": "rimraf dist/ && yarn tsc:build && yarn tsc:alias",
        "build:watch": "concurrently 'yarn tsc:build -w' 'yarn tsc:alias -w'",
        "dev": "tsx ./src/index.ts",
        "start": "node ./dist/index.js",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias -p tsconfig.build.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./index.js",
        "./README.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/tsconfig": "workspace:^",
        "@types/eslint": "^9.6.1",
        "@types/node": "^26.1.1",
        "@typescript-eslint/parser": "^8.64.0",
        "@vitest/coverage-istanbul": "^4.1.10",
        "concurrently": "^10.0.3",
        "eslint": "^10.7.0",
        "rimraf": "^6.1.3",
        "semantic-release": "^25.0.7",
        "tsc-alias": "^1.9.1",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@es-joy/jsdoccomment": "^0.88.0",
        "@typescript-eslint/types": "^8.64.0",
        "@typescript-eslint/utils": "^8.64.0",
        "comment-parser": "^1.4.7"
    },
    "packageManager": "yarn@4.17.1"
}
