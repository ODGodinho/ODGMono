{
    "name": "@odg/config",
    "version": "0.0.0",
    "description": "Config interface abstraction",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGMono/tree/main/packages/config",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODGodinho/ODGMono.git",
        "directory": "packages/config"
    },
    "scripts": {
        "tsc": "tsc --noEmit -p tsconfig.json",
        "build": "rimraf dist/ && tsc --project ./tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:watch": "npm run build && (concurrently \"tsc --project ./tsconfig.build.json -w\" \"tsc-alias -p tsconfig.build.json -w\")",
        "start": "node ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md",
        "./agents.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "workspace:^",
        "@odg/tsconfig": "workspace:^",
        "@types/node": ">=24",
        "@vitest/coverage-istanbul": "^4.1.7",
        "concurrently": "^10.0.0",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.8.17",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7",
        "zod": "^4.4.3"
    },
    "packageManager": "yarn@4.13.0"
}
