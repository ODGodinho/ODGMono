{
    "name": "@odg/http",
    "version": "0.0.0",
    "description": "HTTP request pipeline for ODG APIs: routing, error contract, CORS and access log",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "homepage": "https://github.com/ODGodinho/ODGMono/tree/main/packages/http",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODGodinho/ODGMono.git",
        "directory": "packages/http"
    },
    "exports": {
        ".": "./dist/index.js"
    },
    "scripts": {
        "build": "rimraf dist/ && bun run tsc:build && bun run tsc:alias",
        "build:watch": "concurrently 'bun run tsc:build -w' 'bun run tsc:alias -w'",
        "dev": "tsx ./src/index.ts",
        "start": "node ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "test": "vitest run",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias -p tsconfig.build.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "./dist/",
        "./README.md",
        "./AGENTS.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "workspace:^",
        "@odg/tsconfig": "workspace:^",
        "@types/node": ">=24",
        "@vitest/coverage-istanbul": "^5.0.3",
        "concurrently": "^10.0.3",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.7",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3",
        "zod": "^4.5.4"
    },
    "dependencies": {
        "@odg/chemical-x": "workspace:^",
        "@odg/exception": "workspace:^",
        "@odg/json-log": "workspace:^",
        "@odg/log": "workspace:^",
        "@orpc/client": "1.15.0",
        "@orpc/contract": "1.15.0",
        "@orpc/openapi": "1.15.0",
        "@orpc/server": "1.15.0",
        "@orpc/zod": "1.15.0",
        "error-stack-parser": "^2.1.4",
        "http-status": "^2.1.0"
    },
    "peerDependencies": {
        "@odg/chemical-x": "workspace:^",
        "@odg/exception": "workspace:^",
        "@odg/json-log": "workspace:^",
        "@odg/log": "workspace:^",
        "zod": "*"
    }
}
