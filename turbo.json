{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [ "^build" ],
            "outputs": [ "dist/**", "build/**" ]
        },
        "test": {
            "dependsOn": [ ]
        },
        "test:ci": {
            "dependsOn": [ ]
        },
        "lint": {
            "dependsOn": []
        },
        "lint:fix": {
            "dependsOn": []
        },
        "tsc:check": {
            "dependsOn": []
        }
    }
}
