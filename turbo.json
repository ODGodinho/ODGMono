{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [ "^build" ],
            "outputs": [ "dist/**", "build/**" ]
        },
        "test": {
            "dependsOn": [ "build" ]
        },
        "test:ci": {
            "dependsOn": [ "build" ]
        },
        "lint": {},
        "lint:fix": {},
        "tsc": {}
    }
}
